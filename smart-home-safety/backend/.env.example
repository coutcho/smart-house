# Server Configuration
PORT=5000
NODE_ENV=development

# Sensor Simulator Authentication Key
SENSOR_API_KEY=smart_home_sensor_secret_key_2026

# Default House Identifier
DEFAULT_HOUSE_ID=HOUSE_001

# Firebase Configuration
# Path to serviceAccountKey.json (downloaded from Firebase Console)
# If left empty or file does not exist, the server operates in an integrated High-Fidelity In-Memory Store
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
FIREBASE_PROJECT_ID=smart-home-safety-demo

# Watchdog Configuration (in seconds)
WATCHDOG_CHECK_INTERVAL_SEC=15
SENSOR_WARNING_TIMEOUT_SEC=60
SENSOR_OFFLINE_TIMEOUT_SEC=120
