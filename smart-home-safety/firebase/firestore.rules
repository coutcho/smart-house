rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isHouseMember(houseId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/houses/$(houseId)).data.ownerId ||
        request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberIds
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false; // Disallow accidental user deletion
    }

    // Houses Collection
    match /houses/{houseId} {
      allow read: if isHouseMember(houseId);
      allow create: if isAuthenticated();
      allow update: if isHouseMember(houseId);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // Sensors Collection (no cameras, no motion)
    match /sensors/{sensorId} {
      allow read: if isHouseMember(resource.data.houseId);
      // Writes are restricted to backend service account (Admin SDK bypasses rules)
      allow write: if false;
    }

    // Sensor Readings Collection (Time-series telemetry)
    match /sensorReadings/{readingId} {
      allow read: if isHouseMember(resource.data.houseId);
      // Ingestion is performed via backend API only
      allow write: if false;
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow read: if isHouseMember(resource.data.houseId);
      // Users can acknowledge or resolve alerts
      allow update: if isHouseMember(resource.data.houseId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgedAt', 'acknowledgedBy', 'resolvedAt', 'resolvedBy']);
      allow create, delete: if false; // Generated by backend ERE only
    }

    // Emergency Responses Collection
    match /emergencyResponses/{responseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated and updated exclusively by backend
    }

    // Devices Collection (Smart Actuators: valves, heating, lighting)
    match /devices/{deviceId} {
      allow read: if isHouseMember(resource.data.houseId);
      allow write: if false; // State changes must be routed through backend orchestrator
    }

    // Device Actions Collection (Audit trail)
    match /deviceActions/{actionId} {
      allow read: if isHouseMember(resource.data.houseId);
      allow create: if isHouseMember(request.resource.data.houseId) && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false; // Immutable audit log
    }
  }
}
